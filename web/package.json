    "test:pipelines:browser": "playwright test --config playwright.pipeline.config.ts",
    "test:integrations:browser": "playwright test --config playwright.integrations.config.ts",
    "test:fleet:browser": "playwright test --config playwright.fleet.config.ts",
    "test:observability:browser": "playwright test --config playwright.observability.config.ts",
