# Copy outside Git, restrict file access, and supply independent test/staging secrets.
# Empty placeholders are intentional; never copy Struct production credentials.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TCP_CREDENTIAL_KEY=
STRUCT_INTEGRATION_KEY=
STRUCT_SECURE_V2_ENABLED=true
STRUCT_DELIVERY_PIPELINE_V2=true
STRUCT_FLEET_ENABLED=true
STRUCT_INTEGRATIONS_ENABLED=true
STRUCT_OBSERVABILITY_ENABLED=true
STRUCT_ENTERPRISE_ENABLED=true
OUTBOX_EMBEDDED=false
TCP_PORT=8080
UDP_PORT=8081
STRUCT_APP_URL=
# Optional mail delivery: verified sender and private API credential.
RESEND_API_KEY=
STRUCT_ALERT_EMAIL_FROM=
# Nuxt deployment (separate website/API process) also needs its own public Auth
# URL/key, private service key and NUXT_PUBLIC_* activation flags.
# Configure SDK generation on that web process with HTTPS bootstrap:
STRUCT_INGEST_HOST=
STRUCT_INGEST_PORT=8081
STRUCT_BOOTSTRAP_ORIGIN=
