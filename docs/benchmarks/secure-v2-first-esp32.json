n  if (value_0 < -40.0) value_0 = -40.0;\n  if (value_0 > 125.0) value_0 = 125.0;\n  double rounded_0 = floor((value_0 - -40.0) / 0.1 + 0.5 + 1e-7);\n  if (rounded_0 < 0 || rounded_0 >= 1651.0) return 0;\n  uint32_t code_0 = (uint32_t)rounded_0;\n  double value_1 = p->f_humidity;\n  if (!isfinite(value_1)) return 0;\n  if (value_1 < 0.0 - 0.1 * 1e-7 || value_1 > 100.0 + 0.1 * 1e-7) return 0;\n  if (value_1 < 0.0) value_1 = 0.0;\n  if (value_1 > 100.0) value_1 = 100.0;\n  double rounded_1 = floor((value_1 - 0.0) / 0.1 + 0.5 + 1e-7);\n  if (rounded_1 < 0 || rounded_1 >= 1001.0) return 0;\n  uint32_t code_1 = (uint32_t)rounded_1;\n  uint32_t code_2 = p->f_is_active ? 1u : 0u;\n  memset(out,0,STRUCT_PACKET_SIZE);\n  struct_pack_bits(out, 0u, 11u, code_0);\n  struct_pack_bits(out, 11u, 10u, code_1);\n  struct_pack_bits(out, 21u, 1u, code_2);\n  return STRUCT_PACKET_SIZE;\n}\n#endif\n"
